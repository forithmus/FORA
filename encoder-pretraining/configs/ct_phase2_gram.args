--modality ct --stage gram --arch large
--batch-size 8 --workers 16 --seed 3407
--global-shape 64 192 192 --local-shape 32 96 96 --local-crops 8 --global-overlap 0.25
--mip-probability 0.25 --mip-slab-mm 10.0
--dino-prototypes 16384 --ibot-prototypes 16384 --dino-head-hidden-dim 2048 --ibot-head-hidden-dim 2048
--dino-bottleneck-dim 256 --ibot-bottleneck-dim 256 --position-bins 2 2 2
--cross-view-weight 1.0 --ibot-weight 1.0 --koleo-weight 0.1 --gram-weight 1.0 --gram-max-tokens 1024
--mask-min 0.1 --mask-max 0.5 --ibot-loss-chunk-size 2048
--lr 0.0005 --min-lr 0.000001 --warmup-steps 250 --weight-decay 0.1 --weight-decay-end 0.4
--adamw-beta1 0.9 --adamw-beta2 0.999 --layerwise-decay 0.9 --patch-embed-lr-mult 0.2 --freeze-last-layer-steps 1
--teacher-momentum 0.996 --teacher-temperature 0.07 --teacher-warmup-temperature 0.07 --teacher-warmup-steps 1
--steps 10000 --stop-after-step 5000
--clip-grad 3.0 --save-every 500 --keep-checkpoints 6 --log-every 10 --compile
